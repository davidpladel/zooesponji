# Copiar a .env.production.local y rellenar. Ese archivo no se sube al repositorio.
VITE_MATOMO_URL=
VITE_MATOMO_SITE=
# Cinco ids separados por comas: versión, plataforma, idioma, sesión, antigüedad.
VITE_MATOMO_DIMS=
# Opcional. Horas hacia atrás que acepta el Matomo una fecha sin token. Por defecto 23.
# Solo subirlo (p. ej. 167) si se ha ampliado la ventana en la configuración del servidor.
VITE_MATOMO_REPLAY_HOURS=

# Publicidad con premio (solo Android). Bloques de anuncios de AdMob: ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
# Si falta uno, ese hueco no existe; si faltan los dos, no hay publicidad.
VITE_ADMOB_REWARDED=
VITE_ADMOB_REWARDED_INTERSTITIAL=
# Opcional. Con 1, la compilación de producción pide los anuncios de prueba de Google (para probar en el móvil).
VITE_ADMOB_TESTING=

# Tablón de la comunidad (votaciones). Dirección del servidor, sin barra al final: https://api.zooesponji.com
# Si falta, el juego no tiene tablón.
VITE_COMMUNITY_URL=
