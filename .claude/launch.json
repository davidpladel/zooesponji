{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "game",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "game"
      ],
      "port": 5173
    },
    {
      "name": "game-5174",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "game",
        "--",
        "--port",
        "5174",
        "--strictPort"
      ],
      "port": 5174,
      "autoPort": false
    },
    {
      "name": "game-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "preview",
        "--prefix",
        "game",
        "--",
        "--port",
        "4173",
        "--strictPort"
      ],
      "port": 4173,
      "autoPort": false
    },
    {
      "name": "ia-mando",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "ia:mando",
        "--prefix",
        "game"
      ],
      "port": 7801,
      "autoPort": false
    },
    {
      "name": "web",
      "runtimeExecutable": "C:/xampp/php/php.exe",
      "runtimeArgs": [
        "-S",
        "localhost:8090",
        "-t",
        "web/public"
      ],
      "port": 8090,
      "autoPort": false
    },
    {
      "name": "comunidad-local",
      "runtimeExecutable": "C:/xampp/php/php.exe",
      "runtimeArgs": [
        "-S",
        "0.0.0.0:8080",
        "-t",
        "server/public"
      ],
      "port": 8080,
      "autoPort": false
    },
    {
      "name": "game-comunidad-local",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "game",
        "--",
        "--port",
        "5175",
        "--strictPort"
      ],
      "env": {
        "VITE_COMMUNITY_URL": "http://localhost:8080"
      },
      "port": 5175,
      "autoPort": false
    }
  ]
}
