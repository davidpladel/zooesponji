# Copiar a .env.local (ignorado por git) y rellenar. Nunca subir el fichero relleno.
# Usuario y servidor de SSH del servidor de comunidad: usuario@servidor
COMUNIDAD_SSH=
# Ruta en este ordenador de la clave privada de SSH de ese usuario.
COMUNIDAD_SSH_CLAVE=
# Carpeta app/ en el servidor, relativa a la carpeta personal del usuario (p. ej. web/<dominio>/private/app).
COMUNIDAD_APP=
